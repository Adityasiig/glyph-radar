<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="com.nothing.ketchum.permission.ENABLE" />

    <!-- Android 11+ hides other packages unless they are declared here.
         GlyphMatrixManager.init() binds to com.nothing.thirdparty and
         throws away the bindService() result, so without this the bind
         fails silently: onServiceConnected never fires and the toy
         draws nothing at all, with no error anywhere. -->
    <queries>
        <package android:name="com.nothing.thirdparty" />
        <intent>
            <action android:name="com.nothing.thirdparty.bind_glyphservice" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.DayNight.NoActionBar">

        <!-- Issued per package name from Nothing's developer programme.
             Registration fails without it, so the toy never draws. -->
        <meta-data
            android:name="NothingKey"
            android:value="@string/nothing_api_key" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The Glyph Toy itself. Nothing's launcher discovers this
             through the TOY action and lists it in Glyph Toys. -->
        <service
            android:name=".RadarToyService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.nothing.glyph.TOY" />
            </intent-filter>

            <meta-data
                android:name="com.nothing.glyph.toy.name"
                android:resource="@string/toy_name" />
            <meta-data
                android:name="com.nothing.glyph.toy.image"
                android:resource="@drawable/toy_preview" />
            <!-- The (4a) Pro is AOD-only; it has no Glyph Touch. -->
            <meta-data
                android:name="com.nothing.glyph.toy.aod_support"
                android:value="1" />
        </service>
    </application>
</manifest>
